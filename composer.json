{
	"name": "offsetwp/hook",
	"type": "library",
	"description": "Typed, secure, modern, and object-oriented hook registration for WordPress",
	"license": "MIT",
	"authors": [
		{
			"name": "Jérôme Wohlschlegel",
			"email": "jerome.wohlschlegel@gmail.com"
		}
	],
	"keywords": ["offsetwp", "wordpress", "hook", "add_action", "add_filter", "add_shortcode"],
	"autoload": {
		"psr-4": {
			"OffsetWP\\Hook\\": "src/"
		}
	},
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.3"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"lint": "@php vendor/bin/phpcs"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
